#include <winres.h>

1 ICON "zorlo.ico"
1 RT_MANIFEST "desktop.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,1,0,0
 PRODUCTVERSION 0,1,0,0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Zorlo"
      VALUE "FileDescription", "Zorlo"
      VALUE "FileVersion", "0.1"
      VALUE "InternalName", "Zorlo Desktop"
      VALUE "LegalCopyright", "\xa9 2026 Haider Md. Faiyaz Hussain Shahi"
      VALUE "OriginalFilename", "Zorlo Desktop.exe"
      VALUE "ProductName", "Zorlo"
      VALUE "ProductVersion", "0.1"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
